<configuration>
    <!-- Everything goes to stderr: in stdio mode, stdout carries the MCP protocol. -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- The MCP SDK logs every tool registration and session event at INFO. -->
    <logger name="io.modelcontextprotocol" level="WARN"/>
    <logger name="FeatureRegistry[Tool]" level="WARN"/>
    <logger name="FeatureRegistry[Prompt]" level="WARN"/>
    <logger name="FeatureRegistry[Resource]" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
